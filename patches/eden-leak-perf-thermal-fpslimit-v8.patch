+bool InvokeProgressCallback(JNIEnv* env, jobject callback, jmethodID invoke, size_t max,
+                            size_t progress) {
+    jobject j_max = Common::Android::ToJDouble(env, static_cast<double>(max));
+    jobject j_progress = Common::Android::ToJDouble(env, static_cast<double>(progress));
+    jobject j_result = env->CallObjectMethod(callback, invoke, j_max, j_progress);
+    const bool cancelled = j_result != nullptr && Common::Android::GetJBoolean(env, j_result);
+    env->DeleteLocalRef(j_max);
+    env->DeleteLocalRef(j_progress);
+    if (j_result != nullptr) {
+        env->DeleteLocalRef(j_result);
+    }
+    return cancelled;
+}
