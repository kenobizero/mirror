+// Log calls are synchronous (formatting + logcat + file write on the calling thread), so a stubbed
+// service or a warning inside a per-draw/per-frame path that fires thousands of times costs real
+// emulation time and floods the log. Each call site is allowed a short burst, after which only
+// every RepeatInterval-th occurrence is written, tagged with the running count.
+struct RepeatSlot {
+    std::atomic<u64> key{0};
+    std::atomic<u32> count{0};
+};
+constexpr size_t RepeatSlotCount = 1024;
+constexpr u32 RepeatBurst = 32;
+constexpr u32 RepeatInterval = 1024;
+std::array<RepeatSlot, RepeatSlotCount> repeat_slots{};
+
+/// Returns how many times this call site has been hit (1-based, approximate under contention).
+u32 CountCallSite(const char* filename, unsigned int line_num) noexcept {
+    u64 key = static_cast<u64>(reinterpret_cast<uintptr_t>(filename));
+    key ^= static_cast<u64>(line_num) * 0x9E3779B97F4A7C15ULL;
+    key ^= key >> 29;
+    key |= 1; // 0 marks an empty slot
+    RepeatSlot& slot = repeat_slots[(key ^ (key >> 32)) % RepeatSlotCount];
