+    /// Gives back the physical memory behind every committed page while keeping the reservation,
+    /// so later accesses still read zeroes instead of faulting.
+    void DecommitAll() noexcept {
+        if (base_ptr == nullptr) {
+            return;
+        }
+        for (std::size_t word = 0; word < committed_pages.size(); ++word) {
